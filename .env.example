# Copy this file to .env in the project folder before the first Airflow start.
# .env is ignored by Git. Leave secret values out of this example file.

# Windows and Docker Desktop use the image's default Airflow user id.
AIRFLOW_UID=50000

# Name of the image built from the local Dockerfile.
AIRFLOW_IMAGE_NAME=ookla-airflow:3.3.2

# Required by the official Compose file. Generate a key and paste it into .env
# before the first start. Do not put the generated value in this file.
# After the image has been built, this command prints a new key:
#   docker compose run --rm airflow-cli python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Optional. An empty value keeps the official local UI account from the Compose file.
_AIRFLOW_WWW_USER_USERNAME=
_AIRFLOW_WWW_USER_PASSWORD=
