# Python virtual environments
.venv/
venv/
env/
ENV/

# Secrets and local environment variables
.env
.env.*
!.env.example

# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Test and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Generated data files. The folders stay in the project via .gitkeep.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Local DuckDB database files
*.duckdb
*.duckdb.wal

# Windows and editor junk
Thumbs.db
Desktop.ini
.DS_Store
